PREFIX mvp: <https://w3id.org/mommis/mvp/>
SELECT ?assertion ?statement ?system ?exposure ?comparator ?studyDesign ?endpointType ?status WHERE {
 ?assertion mvp:stageKey ?stage; mvp:statement ?statement; mvp:system ?system;
 mvp:exposure ?exposure; mvp:comparator ?comparator; mvp:reviewStatus ?status; mvp:studyDesign ?studyDesign; mvp:endpointType ?endpointType.
 FILTER (?stage IN ("immune", "epithelial", "clinical"))
} ORDER BY ?assertion
