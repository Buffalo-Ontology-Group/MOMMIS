pilot:E001 a pilot:StudyAssertion ;
  dct:identifier "E001" ;
  dct:description "Bi-26 grew with 2′-FL in culture; growth was lower than with lactose and higher than the no-added-carbohydrate control." ;
  pilot:system "In vitro" ;
  pilot:exposureType "Isolated glycan" ;
  pilot:exposure "2′-FL in culture medium" ;
  pilot:organism "Bifidobacterium longum subsp. infantis" ;
  pilot:strain "Bi-26 (ATCC SD-6720)" ;
  pilot:model "Anaerobic culture in modified Bifidobacterium medium 58 at 37 °C" ;
  pilot:dose "Not transcribed; consult Methods before quantitative reuse." ;
  pilot:duration "24-hour growth assay" ;
  pilot:comparator "Lactose and no-added-carbohydrate controls" ;
  pilot:endpoint "Culture growth (A600 and area under growth curve)" ;
  pilot:sourceLocation "Results: Growth of B. longum subsp. infantis Bi-26 on 2′-FL, and lactose; Figure 2A–B; Methods: Growth conditions" ;
  pilot:limitation "Culture growth is not evidence of infant clinical benefit or utilization by every B. infantis strain." ;
  pilot:status "Draft extraction" ;
  pilot:mentionsGlycan pilot:2fl ;
  prov:wasDerivedFrom <https://doi.org/10.1038/s41598-019-43780-9> .

