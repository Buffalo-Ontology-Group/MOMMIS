pilot:E003 a pilot:StudyAssertion ;
  dct:identifier "E003" ;
  dct:description "In germ-free mice, the BI + HMO group had a higher mesenteric-lymph-node Th17-cell proportion than the HMO-only group." ;
  pilot:system "Animal" ;
  pilot:exposureType "Mixture + microbe" ;
  pilot:exposure "B. infantis ATCC 15697 plus 2′-FL, LNT and 3′-SL" ;
  pilot:organism "Bifidobacterium longum subsp. infantis" ;
  pilot:strain "ATCC 15697" ;
  pilot:model "Germ-free mice; four intervention groups" ;
  pilot:dose "5 mg/day of each HMO (15 mg/day total); 1 × 10^9 CFU per bacterial dosing day" ;
  pilot:duration "14 days; bacterial gavage on days 1, 4 and 9" ;
  pilot:comparator "Same HMO mixture without B. infantis" ;
  pilot:endpoint "MLN Th17 cells as a percentage of CD4+ T cells" ;
  pilot:sourceLocation "PDF page 3: B. infantis shapes spleen and MLN immune cell composition; Figure 3; Figure 1 study design" ;
  pilot:limitation "2′-FL was one of three HMOs. The comparison does not isolate a 2′-FL effect, establish a microbial mechanism, or show a clinical benefit in infants." ;
  pilot:status "Draft extraction" ;
  pilot:mentionsGlycan pilot:2fl ;
  prov:wasDerivedFrom <https://doi.org/10.1128/msystems.00392-26> .
