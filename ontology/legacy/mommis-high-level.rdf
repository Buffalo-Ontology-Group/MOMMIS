    <!-- http://example.org/ontology#InnateImmuneResponse -->

    <NamedIndividual rdf:about="http://example.org/ontology#InnateImmuneResponse"/>
    


    <!-- http://example.org/ontology#IntestinalEpithelialCells -->

    <NamedIndividual rdf:about="http://example.org/ontology#IntestinalEpithelialCells"/>
    


    <!-- http://example.org/ontology#MilkFatGlobuleMembrane -->

    <NamedIndividual rdf:about="http://example.org/ontology#MilkFatGlobuleMembrane">
        <ex:adjacentTo rdf:resource="http://example.org/ontology#IntestinalEpithelialCells"/>
        <ex:affects rdf:resource="http://example.org/ontology#IntestinalEpithelialCells"/>
    </NamedIndividual>
    


    <!-- http://example.org/ontology#Phagocytosis -->

    <NamedIndividual rdf:about="http://example.org/ontology#Phagocytosis">
        <ex:positivelyRegulates rdf:resource="http://example.org/ontology#InnateImmuneResponse"/>
    </NamedIndividual>
    


    <!-- http://example.org/ontology#TCellActivation -->

    <NamedIndividual rdf:about="http://example.org/ontology#TCellActivation">
        <ex:positivelyRegulates rdf:resource="http://example.org/ontology#ImmuneHealth"/>
    </NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://example.org/ontology#BCellActivation">
        <rdfs:isDefinedBy>A biological process where B cells become activated upon recognizing specific antigens, initiating antibody production</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#BioactivePeptide">
        <rdfs:isDefinedBy>Short peptide sequences derived from proteins that exert a biological effect, often modulating immune or gut functions</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#CytokineProduction">
        <rdfs:isDefinedBy>The process by which immune or epithelial cells synthesize and release cytokines, signaling molecules involved in immune regulation</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#GutAssociatedLymphoidTissue">
        <rdfs:comment>Abbreviation: GALT</rdfs:comment>
        <rdfs:isDefinedBy>Lymphoid tissue located in the gut (e.g., Peyer’s patches), essential for initiating immune responses to intestinal antigens</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#GutMicrobiotaBalance">
        <rdfs:comment>Connects to Health Types Ontology AND to Fucosylated HMO Ontology</rdfs:comment>
        <rdfs:isDefinedBy>A condition representing the compositional and functional equilibrium of microbial populations in the gastrointestinal tract</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#HumanMilkOligosaccharides">
        <rdfs:comment>Should this specify 3-10 monosaccharides?</rdfs:comment>
        <rdfs:isDefinedBy>Complex sugars found in human milk that are not digestible by infants but support beneficial gut microbiota and immune development</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#ImmuneHealth">
        <rdfs:comment>Connects to Health Types Ontology</rdfs:comment>
        <rdfs:isDefinedBy>The body&apos;s ability to defend against pathogens and maintain tolerance to self-antigens</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#ImmunoglobulinAProduction">
        <rdfs:isDefinedBy>The biosynthesis of IgA antibodies, primarily occurring in mucosal tissues and important for immune defense in the gut</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#InnateImmuneResponse">
        <rdfs:comment>Connects to Health Types Ontology</rdfs:comment>
        <rdfs:isDefinedBy>The body&apos;s first line of defense, providing a rapid but generalized response to pathogens</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#IntestinalEpithelialCells">
        <rdfs:isDefinedBy>Cells lining the intestine that form a barrier and participate in nutrient absorption and immune signaling</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#MilkFatGlobuleMembrane">
        <rdfs:isDefinedBy>A triple-layer membrane structure that surrounds fat globules in milk, containing bioactive proteins and lipids</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#Phagocytosis">
        <rdfs:isDefinedBy>The process by which certain immune cells (e.g., macrophages) engulf and digest pathogens and debris</rdfs:isDefinedBy>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology#TCellActivation">
        <rdfs:isDefinedBy>The process of T cell engagement and stimulation through antigen recognition, leading to proliferation and immune activity</rdfs:isDefinedBy>
    </rdf:Description>
</rdf:RDF>



