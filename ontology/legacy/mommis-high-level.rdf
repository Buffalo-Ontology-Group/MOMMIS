    <!-- http://example.org/ontology#BCellActivation -->

    <NamedIndividual rdf:about="http://example.org/ontology#BCellActivation">
        <ex:induces rdf:resource="http://example.org/ontology#ImmunoglobulinAProduction"/>
    </NamedIndividual>
    


    <!-- http://example.org/ontology#BioactivePeptide -->

    <NamedIndividual rdf:about="http://example.org/ontology#BioactivePeptide">
        <ex:affects rdf:resource="http://example.org/ontology#GutAssociatedLymphoidTissue"/>
        <ex:enables rdf:resource="http://example.org/ontology#Phagocytosis"/>
        <ex:regulates rdf:resource="http://example.org/ontology#CytokineProduction"/>
    </NamedIndividual>
    


    <!-- http://example.org/ontology#CytokineProduction -->

    <NamedIndividual rdf:about="http://example.org/ontology#CytokineProduction">
        <ex:positivelyRegulates rdf:resource="http://example.org/ontology#InnateImmuneResponse"/>
    </NamedIndividual>
    


    <!-- http://example.org/ontology#GutAssociatedLymphoidTissue -->

