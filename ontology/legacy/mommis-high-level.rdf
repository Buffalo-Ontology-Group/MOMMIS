    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#AdaptiveImmuneResponse -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#AdaptiveImmuneResponse">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <rdfs:comment>Connects to Health Types Ontology</rdfs:comment>
        <rdfs:isDefinedBy>A specialized response where the immune system learns to recognize and remember specific pathogens for faster responses upon re-exposure</rdfs:isDefinedBy>
    </Class>
    


