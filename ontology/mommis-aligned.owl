    <rdf:first rdf:resource="http://purl.obolibrary.org/obo/mommis#MilkChemicalComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#GutMicrobiotaBalance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>gut microbiota balance</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:comment>Upper category intentionally unresolved; no function/disposition axiom retained.</rdfs:comment>
    <rdfs:comment>A proposed descriptor of gut microbial community composition or function. Operational definition and upper category unresolved.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#GutMicrobiotaBalance"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Connects to Health Types Ontology AND to Fucosylated HMO Ontology</mommis:legacyDefinition>
    <mommis:legacyDefinition>A condition representing the compositional and functional equilibrium of microbial populations in the gastrointestinal tract</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#AdaptiveImmuneResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>adaptive immune response</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0002250"/>
    <mommis:legacyIRI rdf:resource="http://www.co-ode.org/ontologies/ont.owl#AdaptiveImmuneResponse"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Connects to Health Types Ontology</mommis:legacyDefinition>
    <mommis:legacyDefinition>A specialized response where the immune system learns to recognize and remember specific pathogens for faster responses upon re-exposure</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#TCellActivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>t cell activation</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0042110"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#TCellActivation"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>The process of T cell engagement and stimulation through antigen recognition, leading to proliferation and immune activity</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#affects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>affects</rdfs:label>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#affects"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#affects"/>
    <mommis:reviewStatus>Legacy relation; alignment pending; not used for biological assertions in this draft</mommis:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#PositiveRegulationBy2FL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>positive regulation of bacterial cell population proliferation by 2'-FL</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/mommis#PositiveRegulationByPrebioticMaterial"/>
    <owl:equivalentClass rdf:nodeID="N456250629bba488dbc432e7ac3d9d51e"/>
    <mommis:reviewStatus>Disposition choice agreed; formalization from supplied slide, pending full import validation</mommis:reviewStatus>
    <rdfs:comment>Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#BioactivePeptide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>bioactive peptide</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16670"/>
    <rdfs:comment>A peptide considered for its biological activity; the criterion and role/disposition pattern remain to be specified.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#BioactivePeptide"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#BioactivePeptide"/>
    <dcterms:source>legacy/mommis-2025.ttl</dcterms:source>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>A peptide that has a biological effect on a living organism, tissue, or cell.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Bioactive peptides are inactive within the sequence of the parent protein and can be released during digestion or processing.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Short peptide sequences derived from proteins that exert a biological effect, often modulating immune or gut functions</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#MilkFatGlobuleMembrane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>milk fat globule membrane</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
    <rdfs:comment>The membrane structure surrounding a milk fat globule. More specific upstream mapping remains to be reviewed.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#MilkFatGlobuleMembrane"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>A triple-layer membrane structure that surrounds fat globules in milk, containing bioactive proteins and lipids</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N261a47ccfd7a4b0db76c785d4f6772e5">
