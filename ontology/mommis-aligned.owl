  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#HumanMilkOligosaccharides">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>human milk oligosaccharides</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50699"/>
    <rdfs:comment>An oligosaccharide category associated with human milk. Occurrence-based versus structural membership, including synthetic material, remains to be defined.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#HumanMilkOligosaccharides"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#HumanMilkOligosaccharides"/>
    <dcterms:source>legacy/mommis-2025.ttl</dcterms:source>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Complex carbohydrates found in human milk that influence the gut microbiota and immune system.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Human milk oligosaccharides (HMOs) are a significant component of human milk and act as prebiotics, immune modulators, and pathogen inhibitors.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Should this specify 3-10 monosaccharides?</mommis:legacyDefinition>
    <mommis:legacyDefinition>Complex sugars found in human milk that are not digestible by infants but support beneficial gut microbiota and immune development</mommis:legacyDefinition>
  </rdf:Description>
