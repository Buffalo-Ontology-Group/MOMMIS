  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#GutMicrobiotaBalance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>gut microbiota balance</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:comment>Upper category intentionally unresolved; no function/disposition axiom retained.</rdfs:comment>
    <rdfs:comment>A proposed descriptor of gut microbial community composition or function. Operational definition and upper category unresolved.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#GutMicrobiotaBalance"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Connects to Health Types Ontology AND to Fucosylated HMO Ontology</mommis:legacyDefinition>
    <mommis:legacyDefinition>A condition representing the compositional and functional equilibrium of microbial populations in the gastrointestinal tract</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#ImmuneHealth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>immune health</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:comment>Upper category intentionally unresolved; no function/disposition axiom retained.</rdfs:comment>
    <rdfs:comment>A proposed immune-health concept. Quality, disposition, and outcome interpretations remain unresolved.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/HEALTH_ImmuneHealth"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#ImmuneHealth"/>
    <dcterms:source>legacy/mommis-2025.ttl</dcterms:source>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>The state of having a properly functioning immune system.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Immune health refers to the balanced state of immune function that provides protection against pathogens while maintaining tolerance to self and harmless environmental antigens.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Connects to Health Types Ontology</mommis:legacyDefinition>
    <mommis:legacyDefinition>The body's ability to defend against pathogens and maintain tolerance to self-antigens</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#CytokineProduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>cytokine production</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0001816"/>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#CytokineProduction"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#CytokineProduction"/>
    <dcterms:source>legacy/mommis-2025.ttl</dcterms:source>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>The biological process that results in the production of cytokines.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Cytokines are signaling molecules that mediate and regulate immunity, inflammation, and hematopoiesis.</mommis:legacyDefinition>
    <mommis:legacyDefinition>The process by which immune or epithelial cells synthesize and release cytokines, signaling molecules involved in immune regulation</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#InnateImmuneResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>innate immune response</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0045087"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#InnateImmuneResponse"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Connects to Health Types Ontology</mommis:legacyDefinition>
    <mommis:legacyDefinition>The body's first line of defense, providing a rapid but generalized response to pathogens</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#IntestinalEpithelialCells">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>intestinal epithelial cells</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000000"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#IntestinalEpithelialCells"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Cells lining the intestine that form a barrier and participate in nutrient absorption and immune signaling</mommis:legacyDefinition>
  </rdf:Description>
