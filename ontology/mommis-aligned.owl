  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#PrebioticDisposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>prebiotic disposition</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    <rdfs:subClassOf rdf:nodeID="N6a7c17f558b84298b768259c56819c25"/>
    <rdfs:comment>A disposition of a material entity to promote the proliferation of certain bacterial species. Disposition rather than role agreed by Emily and Alex, as confirmed by Emily on 2026-10-14. This working definition does not alone establish a clinical health benefit.</rdfs:comment>
    <rdfs:comment>Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent.</rdfs:comment>
    <mommis:reviewStatus>Disposition choice agreed; formalization from supplied slide, pending full import validation</mommis:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#PositiveRegulationOfBacterialCellPopulationProliferation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
