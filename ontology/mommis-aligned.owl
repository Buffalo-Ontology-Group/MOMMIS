  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#Phagocytosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>phagocytosis</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0006909"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#Phagocytosis"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>The process by which certain immune cells (e.g., macrophages) engulf and digest pathogens and debris</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#BCellActivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>b cell activation</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0042113"/>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#BCellActivation"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#BCellActivation"/>
    <dcterms:source>legacy/mommis-2025.ttl</dcterms:source>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>The process in which B cells are activated, leading to antibody production.</mommis:legacyDefinition>
    <mommis:legacyDefinition>The activation of B cells is a key step in the adaptive immune response, leading to antibody production and immunological memory.</mommis:legacyDefinition>
    <mommis:legacyDefinition>A biological process where B cells become activated upon recognizing specific antigens, initiating antibody production</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6a7c17f558b84298b768259c56819c25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
    <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#CytokineProduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>cytokine production</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
    <mommis:candidateMapping rdf:resource="http://purl.obolibrary.org/obo/GO_0001816"/>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#CytokineProduction"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#CytokineProduction"/>
    <dcterms:source>legacy/mommis-2025.ttl</dcterms:source>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>The biological process that results in the production of cytokines.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Cytokines are signaling molecules that mediate and regulate immunity, inflammation, and hematopoiesis.</mommis:legacyDefinition>
    <mommis:legacyDefinition>The process by which immune or epithelial cells synthesize and release cytokines, signaling molecules involved in immune regulation</mommis:legacyDefinition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#MilkChemicalComponent">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    <rdfs:comment>A chemical entity that is part of some milk. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed.</rdfs:comment>
    <rdfs:label>milk chemical component</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nd82eb2368e3140eab51ee3a0cd0fbcfe"/>
    <mommis:legacyIRI rdf:resource="https://example.org/mommis/draft/milk-core/MilkChemicalComponent"/>
  </rdf:Description>
