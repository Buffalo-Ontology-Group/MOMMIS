  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#GutAssociatedLymphoidTissue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>gut associated lymphoid tissue</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000479"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#GutAssociatedLymphoidTissue"/>
    <dcterms:source>legacy/mommis-high-level.rdf</dcterms:source>
    <mommis:legacyDefinition>Abbreviation: GALT</mommis:legacyDefinition>
    <mommis:legacyDefinition>Lymphoid tissue located in the gut (e.g., Peyer’s patches), essential for initiating immune responses to intestinal antigens</mommis:legacyDefinition>
  </rdf:Description>
