    <mommis:legacyIRI rdf:resource="https://example.org/mommis/draft/milk-core/MilkAssociated2FL"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>MOMMIS aligned review draft</rdfs:label>
    <owl:versionInfo>0.2.0-review-2026-10-14</owl:versionInfo>
    <dct:creator>Emily Steliotes</dct:creator>
    <dct:references rdf:resource="https://github.com/Buffalo-Ontology-Group/MOMMIS/pull/2"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdfs:comment>Review derivative of two user-supplied MOMMIS drafts and the milk-core pattern. Existing MOMMIS namespace reused for continuity, not a claim of registered identifiers. External IRIs are declarations; no full import closure. Review annotations are not accepted biological assertions.</rdfs:comment>
    <dct:source>legacy/mommis-2025.ttl</dct:source>
    <dct:source>legacy/mommis-high-level.rdf</dct:source>
    <dct:source>mommis-milk-core.owl</dct:source>
  </rdf:Description>
