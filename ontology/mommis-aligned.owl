  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#MilkAssociated2FL">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_147155"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/mommis#MilkCarbohydrate"/>
    <rdfs:comment>A 2'-fucosyllactose entity that is a milk carbohydrate. This contextual class is distinct from generic 2'-fucosyllactose, including synthesized material. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="N6757bc9c49c34de7ba84f777e02ef178"/>
