  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/mommis#BioactivePeptide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>bioactive peptide</rdfs:label>
    <mommis:reviewStatus>Proposed alignment; Alex Diehl review pending</mommis:reviewStatus>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16670"/>
    <rdfs:comment>A peptide considered for its biological activity; the criterion and role/disposition pattern remain to be specified.</rdfs:comment>
    <mommis:legacyIRI rdf:resource="http://purl.obolibrary.org/obo/mommis#BioactivePeptide"/>
    <mommis:legacyIRI rdf:resource="http://example.org/ontology#BioactivePeptide"/>
    <dct:source>legacy/mommis-2025.ttl</dct:source>
    <dct:source>legacy/mommis-high-level.rdf</dct:source>
    <mommis:legacyDefinition>A peptide that has a biological effect on a living organism, tissue, or cell.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Bioactive peptides are inactive within the sequence of the parent protein and can be released during digestion or processing.</mommis:legacyDefinition>
    <mommis:legacyDefinition>Short peptide sequences derived from proteins that exert a biological effect, often modulating immune or gut functions</mommis:legacyDefinition>
  </rdf:Description>
