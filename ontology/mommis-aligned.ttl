@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mommis: <http://purl.obolibrary.org/obo/mommis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://purl.obolibrary.org/obo/mommis> a owl:Ontology ;
    rdfs:label "MOMMIS aligned review draft" ;
    dcterms:creator "Emily Steliotes" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:references <https://github.com/Buffalo-Ontology-Group/MOMMIS/pull/2> ;
    dcterms:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf",
        "mommis-milk-core.owl" ;
    rdfs:comment "Review derivative of two user-supplied MOMMIS drafts and the milk-core pattern. Existing MOMMIS namespace reused for continuity, not a claim of registered identifiers. External IRIs are declarations; no full import closure. Review annotations are not accepted biological assertions." ;
    owl:versionInfo "2.0.0-mvp" .

mommis:GutAssociatedLymphoidTissue a owl:Class ;
    rdfs:label "gut associated lymphoid tissue" ;
    mommis:legacyDefinition "Abbreviation: GALT",
        "Lymphoid tissue located in the gut (e.g., Peyer’s patches), essential for initiating immune responses to intestinal antigens" ;
    mommis:legacyIRI <http://example.org/ontology#GutAssociatedLymphoidTissue> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dcterms:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000479> .

mommis:GutMicrobiotaBalance a owl:Class ;
    rdfs:label "gut microbiota balance" ;
    mommis:legacyDefinition "A condition representing the compositional and functional equilibrium of microbial populations in the gastrointestinal tract",
        "Connects to Health Types Ontology AND to Fucosylated HMO Ontology" ;
    mommis:legacyIRI <http://example.org/ontology#GutMicrobiotaBalance> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dcterms:source "legacy/mommis-high-level.rdf" ;
    rdfs:comment "A proposed descriptor of gut microbial community composition or function. Operational definition and upper category unresolved.",
        "Upper category intentionally unresolved; no function/disposition axiom retained." .

mommis:ImmuneHealth a owl:Class ;
    rdfs:label "immune health" ;
    mommis:legacyDefinition "Connects to Health Types Ontology",
        "Immune health refers to the balanced state of immune function that provides protection against pathogens while maintaining tolerance to self and harmless environmental antigens.",
        "The body's ability to defend against pathogens and maintain tolerance to self-antigens",
        "The state of having a properly functioning immune system." ;
    mommis:legacyIRI <http://example.org/ontology#ImmuneHealth>,
        <http://purl.obolibrary.org/obo/HEALTH_ImmuneHealth> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dcterms:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf" ;
    rdfs:comment "A proposed immune-health concept. Quality, disposition, and outcome interpretations remain unresolved.",
        "Upper category intentionally unresolved; no function/disposition axiom retained." .

mommis:ImmunoglobulinAProduction a owl:Class ;
    rdfs:label "immunoglobulin a production" ;
    mommis:legacyDefinition "The biosynthesis of IgA antibodies, primarily occurring in mucosal tissues and important for immune defense in the gut" ;
    mommis:legacyIRI <http://example.org/ontology#ImmunoglobulinAProduction> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dcterms:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> .

mommis:InnateImmuneResponse a owl:Class ;
    rdfs:label "innate immune response" ;
    mommis:candidateMapping <http://purl.obolibrary.org/obo/GO_0045087> ;
    mommis:legacyDefinition "Connects to Health Types Ontology",
        "The body's first line of defense, providing a rapid but generalized response to pathogens" ;
    mommis:legacyIRI <http://example.org/ontology#InnateImmuneResponse> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dcterms:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> .

mommis:IntestinalEpithelialCells a owl:Class ;
    rdfs:label "intestinal epithelial cells" ;
    mommis:legacyDefinition "Cells lining the intestine that form a barrier and participate in nutrient absorption and immune signaling" ;
    mommis:legacyIRI <http://example.org/ontology#IntestinalEpithelialCells> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dcterms:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> .

mommis:MilkAssociated2FL a owl:Class ;
    rdfs:label "milk-associated 2'-fucosyllactose" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkAssociated2FL> ;
    rdfs:comment "A 2'-fucosyllactose entity that is a milk carbohydrate. This contextual class is distinct from generic 2'-fucosyllactose, including synthesized material. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_147155>,
        mommis:MilkCarbohydrate ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.obolibrary.org/obo/CHEBI_147155> mommis:MilkCarbohydrate ) ] .

mommis:PositiveRegulationBy2FL a owl:Class ;
    rdfs:label "positive regulation of bacterial cell population proliferation by 2'-FL" ;
    mommis:reviewStatus "Disposition choice agreed; formalization from supplied slide, pending full import validation" ;
    rdfs:comment "Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent." ;
    rdfs:subClassOf mommis:PositiveRegulationByPrebioticMaterial ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mommis:PositiveRegulationOfBacterialCellPopulationProliferation [ a owl:Restriction ;
                        owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( mommis:PrebioticDisposition [ a owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/RO_0000052> ;
                                            owl:someValuesFrom <http://purl.obolibrary.org/obo/CHEBI_147155> ] ) ] ] ) ] .

mommis:PrebioticMaterial a owl:Class ;
    rdfs:label "prebiotic material" ;
    mommis:reviewStatus "Disposition choice agreed; formalization from supplied slide, pending full import validation" ;
    rdfs:comment "Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000040> [ a owl:Restriction ;
                        owl:onProperty <http://purl.obolibrary.org/obo/RO_0000091> ;
                        owl:someValuesFrom mommis:PrebioticDisposition ] ) ] .

mommis:adjacentTo a owl:ObjectProperty ;
    rdfs:label "adjacent to" ;
    mommis:legacyIRI <http://example.org/ontology#adjacentTo> ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

