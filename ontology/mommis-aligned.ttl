@prefix dct: <http://purl.org/dc/terms/> .
@prefix mommis: <http://purl.obolibrary.org/obo/mommis#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

obo:mommis a owl:Ontology ;
    rdfs:label "MOMMIS aligned review draft" ;
    dct:creator "Emily Steliotes" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:references <https://github.com/Buffalo-Ontology-Group/MOMMIS/pull/2> ;
    dct:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf",
        "mommis-milk-core.owl" ;
    rdfs:comment "Review derivative of two user-supplied MOMMIS drafts and the milk-core pattern. Existing MOMMIS namespace reused for continuity, not a claim of registered identifiers. External IRIs are declarations; no full import closure. Review annotations are not accepted biological assertions." ;
    owl:versionInfo "0.2.0-review-2026-10-14" .

mommis:AdaptiveImmuneResponse a owl:Class ;
    rdfs:label "adaptive immune response" ;
    mommis:candidateMapping obo:GO_0002250 ;
    mommis:legacyDefinition "A specialized response where the immune system learns to recognize and remember specific pathogens for faster responses upon re-exposure",
        "Connects to Health Types Ontology" ;
    mommis:legacyIRI <http://www.co-ode.org/ontologies/ont.owl#AdaptiveImmuneResponse> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:GutAssociatedLymphoidTissue a owl:Class ;
    rdfs:label "gut associated lymphoid tissue" ;
    mommis:legacyDefinition "Abbreviation: GALT",
        "Lymphoid tissue located in the gut (e.g., Peyer’s patches), essential for initiating immune responses to intestinal antigens" ;
    mommis:legacyIRI <http://example.org/ontology#GutAssociatedLymphoidTissue> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:UBERON_0000479 .

mommis:GutMicrobiotaBalance a owl:Class ;
    rdfs:label "gut microbiota balance" ;
    mommis:legacyDefinition "A condition representing the compositional and functional equilibrium of microbial populations in the gastrointestinal tract",
        "Connects to Health Types Ontology AND to Fucosylated HMO Ontology" ;
    mommis:legacyIRI <http://example.org/ontology#GutMicrobiotaBalance> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:comment "A proposed descriptor of gut microbial community composition or function. Operational definition and upper category unresolved.",
        "Upper category intentionally unresolved; no function/disposition axiom retained." .

mommis:ImmuneHealth a owl:Class ;
    rdfs:label "immune health" ;
    mommis:legacyDefinition "Connects to Health Types Ontology",
        "Immune health refers to the balanced state of immune function that provides protection against pathogens while maintaining tolerance to self and harmless environmental antigens.",
        "The body's ability to defend against pathogens and maintain tolerance to self-antigens",
        "The state of having a properly functioning immune system." ;
    mommis:legacyIRI <http://example.org/ontology#ImmuneHealth>,
        obo:HEALTH_ImmuneHealth ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf" ;
    rdfs:comment "A proposed immune-health concept. Quality, disposition, and outcome interpretations remain unresolved.",
        "Upper category intentionally unresolved; no function/disposition axiom retained." .

mommis:ImmunoglobulinAProduction a owl:Class ;
    rdfs:label "immunoglobulin a production" ;
    mommis:legacyDefinition "The biosynthesis of IgA antibodies, primarily occurring in mucosal tissues and important for immune defense in the gut" ;
    mommis:legacyIRI <http://example.org/ontology#ImmunoglobulinAProduction> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:InnateImmuneResponse a owl:Class ;
    rdfs:label "innate immune response" ;
    mommis:candidateMapping obo:GO_0045087 ;
    mommis:legacyDefinition "Connects to Health Types Ontology",
        "The body's first line of defense, providing a rapid but generalized response to pathogens" ;
    mommis:legacyIRI <http://example.org/ontology#InnateImmuneResponse> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:IntestinalEpithelialCells a owl:Class ;
    rdfs:label "intestinal epithelial cells" ;
    mommis:legacyDefinition "Cells lining the intestine that form a barrier and participate in nutrient absorption and immune signaling" ;
    mommis:legacyIRI <http://example.org/ontology#IntestinalEpithelialCells> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:CL_0000000 .

mommis:MilkAssociated2FL a owl:Class ;
    rdfs:label "milk-associated 2'-fucosyllactose" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkAssociated2FL> ;
    rdfs:comment "A 2'-fucosyllactose entity that is a milk carbohydrate. This contextual class is distinct from generic 2'-fucosyllactose, including synthesized material. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf obo:CHEBI_147155,
        mommis:MilkCarbohydrate ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:CHEBI_147155 mommis:MilkCarbohydrate ) ] .

mommis:MilkFatGlobuleMembrane a owl:Class ;
    rdfs:label "milk fat globule membrane" ;
    mommis:legacyDefinition "A triple-layer membrane structure that surrounds fat globules in milk, containing bioactive proteins and lipids" ;
    mommis:legacyIRI <http://example.org/ontology#MilkFatGlobuleMembrane> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:comment "The membrane structure surrounding a milk fat globule. More specific upstream mapping remains to be reviewed." ;
    rdfs:subClassOf obo:BFO_0000040 .

mommis:MilkGlycoprotein a owl:Class ;
    rdfs:label "milk glycoprotein" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkGlycoprotein> ;
    rdfs:comment "A glycoprotein that is a milk chemical component. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf obo:CHEBI_17089,
        mommis:MilkChemicalComponent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:CHEBI_17089 mommis:MilkChemicalComponent ) ] .

mommis:Phagocytosis a owl:Class ;
    rdfs:label "phagocytosis" ;
    mommis:candidateMapping obo:GO_0006909 ;
    mommis:legacyDefinition "The process by which certain immune cells (e.g., macrophages) engulf and digest pathogens and debris" ;
    mommis:legacyIRI <http://example.org/ontology#Phagocytosis> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:TCellActivation a owl:Class ;
    rdfs:label "t cell activation" ;
    mommis:candidateMapping obo:GO_0042110 ;
    mommis:legacyDefinition "The process of T cell engagement and stimulation through antigen recognition, leading to proliferation and immune activity" ;
    mommis:legacyIRI <http://example.org/ontology#TCellActivation> ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:adjacentTo a owl:ObjectProperty ;
    rdfs:label "adjacent to" ;
    mommis:legacyIRI <http://example.org/ontology#adjacentTo> ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:candidateMapping a owl:AnnotationProperty .

mommis:enables a owl:ObjectProperty ;
    rdfs:label "enables" ;
    mommis:legacyIRI <http://example.org/ontology#enables> ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:induces a owl:ObjectProperty ;
    rdfs:label "induces" ;
    mommis:legacyIRI <http://example.org/ontology#induces> ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:legacyDefinition a owl:AnnotationProperty .

mommis:legacyIRI a owl:AnnotationProperty .

mommis:positivelyRegulates a owl:ObjectProperty ;
    rdfs:label "positively regulates" ;
    mommis:legacyIRI <http://example.org/ontology#positivelyRegulates> ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:regulates a owl:ObjectProperty ;
    rdfs:label "regulates" ;
    mommis:legacyIRI <http://example.org/ontology#regulates> ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:reviewStatus a owl:AnnotationProperty .

dct:creator a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

dct:license a owl:AnnotationProperty .

dct:references a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity" .

obo:BFO_0000050 a owl:ObjectProperty ;
    rdfs:label "part of" .

obo:CHEBI_16670 a owl:Class ;
    rdfs:label "peptide" .

obo:CHEBI_50699 a owl:Class ;
    rdfs:label "oligosaccharide" .

obo:CL_0000000 a owl:Class ;
    rdfs:label "cell" .

obo:UBERON_0000479 a owl:Class ;
    rdfs:label "tissue" .

obo:UBERON_0001913 a owl:Class ;
    rdfs:label "milk" .

mommis:BCellActivation a owl:Class ;
    rdfs:label "b cell activation" ;
    mommis:candidateMapping obo:GO_0042113 ;
    mommis:legacyDefinition "A biological process where B cells become activated upon recognizing specific antigens, initiating antibody production",
        "The activation of B cells is a key step in the adaptive immune response, leading to antibody production and immunological memory.",
        "The process in which B cells are activated, leading to antibody production." ;
    mommis:legacyIRI <http://example.org/ontology#BCellActivation>,
        mommis:BCellActivation ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:BioactivePeptide a owl:Class ;
    rdfs:label "bioactive peptide" ;
    mommis:legacyDefinition "A peptide that has a biological effect on a living organism, tissue, or cell.",
        "Bioactive peptides are inactive within the sequence of the parent protein and can be released during digestion or processing.",
        "Short peptide sequences derived from proteins that exert a biological effect, often modulating immune or gut functions" ;
    mommis:legacyIRI <http://example.org/ontology#BioactivePeptide>,
        mommis:BioactivePeptide ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf" ;
    rdfs:comment "A peptide considered for its biological activity; the criterion and role/disposition pattern remain to be specified." ;
    rdfs:subClassOf obo:CHEBI_16670 .

mommis:CytokineProduction a owl:Class ;
    rdfs:label "cytokine production" ;
    mommis:candidateMapping obo:GO_0001816 ;
    mommis:legacyDefinition "Cytokines are signaling molecules that mediate and regulate immunity, inflammation, and hematopoiesis.",
        "The biological process that results in the production of cytokines.",
        "The process by which immune or epithelial cells synthesize and release cytokines, signaling molecules involved in immune regulation" ;
    mommis:legacyIRI <http://example.org/ontology#CytokineProduction>,
        mommis:CytokineProduction ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf" ;
    rdfs:subClassOf obo:GO_0008150 .

mommis:HumanMilkOligosaccharides a owl:Class ;
    rdfs:label "human milk oligosaccharides" ;
    mommis:legacyDefinition "Complex carbohydrates found in human milk that influence the gut microbiota and immune system.",
        "Complex sugars found in human milk that are not digestible by infants but support beneficial gut microbiota and immune development",
        "Human milk oligosaccharides (HMOs) are a significant component of human milk and act as prebiotics, immune modulators, and pathogen inhibitors.",
        "Should this specify 3-10 monosaccharides?" ;
    mommis:legacyIRI <http://example.org/ontology#HumanMilkOligosaccharides>,
        mommis:HumanMilkOligosaccharides ;
    mommis:reviewStatus "Proposed alignment; Alex Diehl review pending" ;
    dct:source "legacy/mommis-2025.ttl",
        "legacy/mommis-high-level.rdf" ;
    rdfs:comment "An oligosaccharide category associated with human milk. Occurrence-based versus structural membership, including synthetic material, remains to be defined." ;
    rdfs:subClassOf obo:CHEBI_50699 .

mommis:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    mommis:legacyIRI <http://example.org/ontology#affects>,
        mommis:affects ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:has_part a owl:ObjectProperty ;
    rdfs:label "has part" ;
    mommis:legacyIRI mommis:has_part ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

mommis:participates_in a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    mommis:legacyIRI mommis:participates_in ;
    mommis:reviewStatus "Legacy relation; alignment pending; not used for biological assertions in this draft" .

obo:CHEBI_147155 a owl:Class ;
    rdfs:label "2'-fucosyllactose" .

obo:CHEBI_16646 a owl:Class ;
    rdfs:label "carbohydrate" .

obo:CHEBI_17089 a owl:Class ;
    rdfs:label "glycoprotein" .

obo:CHEBI_24431 a owl:Class ;
    rdfs:label "chemical entity" .

mommis:MilkCarbohydrate a owl:Class ;
    rdfs:label "milk carbohydrate" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkCarbohydrate> ;
    rdfs:comment "A carbohydrate that is a milk chemical component. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf obo:CHEBI_16646,
        mommis:MilkChemicalComponent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:CHEBI_16646 mommis:MilkChemicalComponent ) ] .

mommis:MilkChemicalComponent a owl:Class ;
    rdfs:label "milk chemical component" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkChemicalComponent> ;
    rdfs:comment "A chemical entity that is part of some milk. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf obo:CHEBI_24431 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:CHEBI_24431 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000050 ;
                        owl:someValuesFrom obo:UBERON_0001913 ] ) ] .

obo:GO_0008150 a owl:Class ;
    rdfs:label "biological process" .

