mommis:PositiveRegulationOfBacterialCellPopulationProliferation a owl:Class ;
    rdfs:label "positive regulation of bacterial cell population proliferation" ;
    mommis:reviewStatus "Disposition choice agreed; formalization from supplied slide, pending full import validation" ;
    rdfs:comment "Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/RO_0002213> ;
            owl:someValuesFrom mommis:BacterialCellPopulationProliferation ],
        <http://purl.obolibrary.org/obo/GO_0008284>,
        mommis:RegulationOfBacterialCellPopulationProliferation .

mommis:PrebioticDisposition a owl:Class ;
    rdfs:label "prebiotic disposition" ;
    mommis:reviewStatus "Disposition choice agreed; formalization from supplied slide, pending full import validation" ;
    rdfs:comment "A disposition of a material entity to promote the proliferation of certain bacterial species. Disposition rather than role agreed by Emily and Alex, as confirmed by Emily on 2026-10-14. This working definition does not alone establish a clinical health benefit.",
        "Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/RO_0000052> ;
            owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040> ],
        <http://purl.obolibrary.org/obo/BFO_0000016> .

