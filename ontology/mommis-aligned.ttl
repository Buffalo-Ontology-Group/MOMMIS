mommis:BacterialCellPopulationProliferation a owl:Class ;
    rdfs:label "bacterial cell population proliferation" ;
    mommis:reviewStatus "Disposition choice agreed; formalization from supplied slide, pending full import validation" ;
    rdfs:comment "Source: user-supplied screenshot, Modeling decision: prebiotic materials and dispositions, 2026-10-14. Local extensions are proposals, not a claim that equivalent upstream terms are absent." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008283> .

mommis:MilkCarbohydrate a owl:Class ;
    rdfs:label "milk carbohydrate" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkCarbohydrate> ;
    rdfs:comment "A carbohydrate that is a milk chemical component. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_16646>,
        mommis:MilkChemicalComponent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.obolibrary.org/obo/CHEBI_16646> mommis:MilkChemicalComponent ) ] .

mommis:MilkChemicalComponent a owl:Class ;
    rdfs:label "milk chemical component" ;
    mommis:legacyIRI <https://example.org/mommis/draft/milk-core/MilkChemicalComponent> ;
    rdfs:comment "A chemical entity that is part of some milk. Proposed equivalence for Alex Diehl review; temporal scope of milk membership remains to be agreed." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.obolibrary.org/obo/CHEBI_24431> [ a owl:Restriction ;
                        owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                        owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001913> ] ) ] .

<http://purl.obolibrary.org/obo/BFO_0000040> a owl:Class ;
    rdfs:label "material entity" .

<http://purl.obolibrary.org/obo/CHEBI_147155> a owl:Class ;
    rdfs:label "2'-fucosyllactose" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/RO_0000091> ;
            owl:someValuesFrom mommis:PrebioticDisposition ] .

<http://purl.obolibrary.org/obo/GO_0008150> a owl:Class ;
